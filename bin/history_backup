#!/usr/bin/env sh
(
  set -o errexit
  set -o noclobber
  set -o noglob
  set -o nounset
  set -o verbose
  set -o xtrace
  # find the newest `$HISTFILE`
  # without specifying the shell
  file="$(
    find -- "${HOME%/}" \
      -path "${HOME%/}"'/[A-Za-z0-9_-]*' -prune -o \
      -path "${HOME%/}"'/*/*' -prune -o \
      -path "${HOME%/}"'/.*history' \
      -type f \
      -exec ls -1 -t -- {} + 2>/dev/null |
      sed -e '1 q'
  )"
  # verify `$HISTFILE` exists and is not empty
  test -s "${file-}" &&
    # ensure a backup directory exists...
    mkdir -p -- "${file-}"'_bak' &&
    {
      # ...and that it is not empty
      test "$(find -- "${file-}"'_bak' -name "${file##*/}"'*' -type f)" != '' ||
        # ...or that its newest file is older than `$HISTFILE`...
        test "$(
          find -- "${file-}" -prune -newer "$(
            # ...by comparing it to the newest file in the backup directory
            find -- "${file-}"'_bak' \
              -path '*/.git' -prune -o \
              -type f \
              -exec ls -1 -t -- {} + 2>/dev/null |
              sed -e '1 q'
          )"
        )" != ''
    } &&
    cp -- "${file-}" "${file-}"'_bak/'"${file##*/}"'_'"$(LANG='C' LC_ALL='C' date -- '+%Y%m%d')"
)
